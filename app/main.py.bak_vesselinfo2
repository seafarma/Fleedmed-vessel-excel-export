def get_export_rows(excel_id: str) -> List[Dict[str, Any]]:
    sql = """
    SELECT
      v.vessel_item_id,
      v.vessel_id,
      v.storage_id,
      v.storage_display,
      v.item_id,
      v.pack_id,
      v.category_id,
      v.item_barcode,
      v.pack_name,
      v.vessel_item_name,
      v.vessel_item_law_code,
      v.vessel_item_quantity,
      v.totalitem_qty_sql,
      v.certificate_qty_sql,
      v.vessel_item_expiration_date
    FROM vw_vessel_excel_items v
    WHERE v.excel_id = %s
    ORDER BY
      COALESCE(v.pack_name,'') ASC,
      COALESCE(v.vessel_item_law_code,'') ASC,
      COALESCE(v.storage_display,'') ASC,
      COALESCE(v.vessel_item_name,'') ASC
    """
    try:
        return fetch_all(sql, (excel_id,))
    except (pg_errors.UndefinedTable, pg_errors.UndefinedColumn):
        sql2 = """
        SELECT
          b.vessel_item_id,
          b.vessel_id,
          b.storage_id,
          b.storage_display,
          b.item_id,
          b.pack_id,
          NULL::text AS category_id,
          b.item_barcode,
          b.pack_name,
          b.vessel_item_name,
          b.vessel_item_law_code,
          b.vessel_item_quantity,
          (SUM(b.vessel_item_quantity) OVER (PARTITION BY b.excel_id, b.item_id))::numeric AS totalitem_qty_sql,
          b.certificate_qty_sql,
          b.vessel_item_expiration_date
        FROM vw_vessel_excel_items_base b
        WHERE b.excel_id = %s
        ORDER BY
          COALESCE(b.pack_name,'') ASC,
          COALESCE(b.vessel_item_law_code,'') ASC,
          COALESCE(b.storage_display,'') ASC,
          COALESCE(b.vessel_item_name,'') ASC
        """
        return fetch_all(sql2, (excel_id,))


def get_vessel_storages(vessel_id: str, rows: List[Dict[str, Any]]) -> List[Tuple[str, str]]:
    out: List[Tuple[str, str]] = []
    seen = set()

    try:
        db_rows = fetch_all(
            "SELECT storage_display, storage_id FROM vessel_storages WHERE vessel_id=%s ORDER BY storage_display",
            (vessel_id,),
        )
        for r in db_rows:
            disp = str(r.get("storage_display") or "").strip()
            sid = str(r.get("storage_id") or "").strip()
            if disp and disp.lower() not in seen:
                out.append((disp, sid))
                seen.add(disp.lower())
    except Exception:
        pass

    for r in rows:
        disp = str(r.get("storage_display") or "").strip()
        sid = str(r.get("storage_id") or "").strip()
        if disp and disp.lower() not in seen:
            out.append((disp, sid))
            seen.add(disp.lower())

    if "inbound storage" not in seen:
        out.insert(0, ("Inbound storage", ""))

    return out


def pick_inbound(storages: List[Tuple[str, str]]) -> Tuple[str, str]:
    for disp, sid in storages:
        if "inbound" in disp.strip().lower():
            return disp, sid
    return ("Inbound storage", storages[0][1] if storages else "")


def build_filename_from_db(excel_row, vessel):
    vessel_id = (excel_row or {}).get("vessel_id")
    vessel_name = (vessel or {}).get("vessel_name") or (vessel or {}).get("name") or ""
    imo = (vessel or {}).get("vessel_IMO") or (vessel or {}).get("vessel_imo") or (vessel or {}).get("imo") or ""
    label = str((vessel or {}).get("vessel_label") or "").strip()

    if vessel_id and (not vessel_name or not imo):
        try:
            row = fetch_one(
                'SELECT vessel_name, "vessel_IMO" AS vessel_imo, vessel_label FROM vessels WHERE vessel_id=%s',
                (vessel_id,),
            )
            if row:
                vessel_name = vessel_name or (row.get("vessel_name") or "")
                imo = imo or (row.get("vessel_imo") or "")
                if not label:
                    label = str(row.get("vessel_label") or "").strip()
        except Exception:
            pass

    if (not vessel_name or not imo) and label:
        parts = [p.strip() for p in label.split("|")]
        if not vessel_name and len(parts) >= 1 and parts[0]:
            vessel_name = parts[0]
        if not imo and len(parts) >= 2 and parts[1]:
            imo = "".join(ch for ch in parts[1] if ch.isdigit())

    vessel_name = str(vessel_name or "Vessel").replace("/", "-").strip()
    imo = str(imo or "").strip()
    date_str = datetime.now().strftime("%d-%m-%Y")

    if imo:
        return f"Medical Inventory List - {vessel_name} - {imo} - {date_str}.xlsx"
    return f"Medical Inventory List - {vessel_name} - {date_str}.xlsx"


def _norm(s: str) -> str:
    s = s.strip().lower()
    s = re.sub(r"\s+", " ", s)
    return s


def header_map(ws, header_row: int = 1) -> Dict[str, int]:
    m: Dict[str, int] = {}
    for c in range(1, ws.max_column + 1):
        v = ws.cell(header_row, c).value
        if isinstance(v, str) and v.strip():
            m[_norm(v)] = c
    return m


def find_col(hmap: Dict[str, int], *candidates: str) -> Optional[int]:
    for cand in candidates:
        key = _norm(cand)
        if key in hmap:
            return hmap[key]
    return None


def clear_cols(ws, start_row: int, end_row: int, cols: List[int]):
    for r in range(start_row, end_row + 1):
        for c in cols:
            ws.cell(r, c).value = None


def set_date_cell(cell, d: Optional[date], fmt: str):
    if d is None:
        cell.value = None
        return
    cell.value = d
    cell.number_format = fmt


def fill_storages_sheet(wb, storages: List[Tuple[str, str]]):
    if STORAGES_SHEET not in wb.sheetnames:
        return
    ws = wb[STORAGES_SHEET]
    for r in range(2, max(ws.max_row, 250) + 1):
        ws.cell(r, 1).value = None
        ws.cell(r, 2).value = None
    for i, (disp, sid) in enumerate(storages, start=2):
        ws.cell(i, 1).value = disp
        ws.cell(i, 2).value = sid


def fill_inventory_sheet(wb, rows: List[Dict[str, Any]], inbound_disp: str):
    if INVENTORY_SHEET not in wb.sheetnames:
        raise HTTPException(status_code=500, detail=f"Sheet '{INVENTORY_SHEET}' not found in template")

    ws = wb[INVENTORY_SHEET]
    h = header_map(ws, 1)

    col_storage = find_col(h, "Storage")
    col_article = find_col(h, "Article No.", "Article No")
    col_item = find_col(h, "Item name", "Item Name")
    col_qty = find_col(h, "Quantity")
    col_total = find_col(h, "Total quantity", "Total Quantity")
    col_cert = find_col(h, "Certificate qty", "Certificate Qty")
    col_exp = find_col(h, "Expiry date", "Expiry Date")
    col_law = find_col(h, "Law code", "Law Code")
    col_pack = find_col(h, "Pack name", "Pack Name")

    missing = [name for name, col in [
        ("Storage", col_storage),
        ("Article No.", col_article),
        ("Item name", col_item),
        ("Quantity", col_qty),
        ("Expiry date", col_exp),
    ] if col is None]
    if missing:
        raise HTTPException(status_code=500, detail=f"Inventory template missing columns: {', '.join(missing)}")

    cols_to_fill = [c for c in [col_storage, col_article, col_item, col_qty, col_total, col_cert, col_exp, col_law, col_pack] if c is not None]

    start_row = 2
    end_row = min(MAX_FILL_ROWS, start_row + max(len(rows), 50))
    clear_cols(ws, start_row, end_row, cols_to_fill)

    for i, r in enumerate(rows):
        row_idx = start_row + i
        if row_idx > MAX_FILL_ROWS:
            break

        storage_disp = str(r.get("storage_display") or "").strip() or inbound_disp
        barcode = str(r.get("item_barcode") or "").strip()
        if not barcode:
            barcode = "Extra"

        ws.cell(row_idx, col_storage).value = storage_disp
        ws.cell(row_idx, col_article).value = barcode
        ws.cell(row_idx, col_item).value = str(r.get("vessel_item_name") or "")

        ws.cell(row_idx, col_qty).value = num_to_int(r.get("vessel_item_quantity")) or 0

        if col_total:
            ws.cell(row_idx, col_total).value = num_to_int(r.get("totalitem_qty_sql")) or 0
        if col_cert:
            ws.cell(row_idx, col_cert).value = num_to_int(r.get("certificate_qty_sql")) or 0

        d = parse_date_any(r.get("vessel_item_expiration_date"))
        set_date_cell(ws.cell(row_idx, col_exp), d, "mm-yyyy")

        if col_law:
            ws.cell(row_idx, col_law).value = str(r.get("vessel_item_law_code") or "")
        if col_pack:
            ws.cell(row_idx, col_pack).value = str(r.get("pack_name") or "")


def fill_upload_sheet(wb, rows: List[Dict[str, Any]], inbound_disp: str, inbound_id: str, storage_id_by_name: Dict[str, str]):
    if UPLOAD_SHEET not in wb.sheetnames:
        return
    ws = wb[UPLOAD_SHEET]
    ws.sheet_state = "hidden"

    h = header_map(ws, 1)
    start_row = 2
    end_row = min(MAX_FILL_ROWS, start_row + max(len(rows), 50))
    cols_to_clear = [c for c in h.values() if isinstance(c, int)]
    clear_cols(ws, start_row, end_row, cols_to_clear)

    def col(name: str) -> Optional[int]:
        return find_col(h, name)

    for i, r in enumerate(rows):
        row_idx = start_row + i
        if row_idx > MAX_FILL_ROWS:
            break

        storage_disp = str(r.get("storage_display") or "").strip() or inbound_disp
        storage_id = str(r.get("storage_id") or "").strip()

        if not storage_id:
            storage_id = storage_id_by_name.get(storage_disp.lower(), "") or (inbound_id if storage_disp.lower() == inbound_disp.lower() else "")

        barcode = str(r.get("item_barcode") or "").strip()
        if not barcode:
            barcode = "123"

        mapping: Dict[str, Any] = {
            "vessel_item_id": r.get("vessel_item_id"),
            "vessel_id": r.get("vessel_id"),
            "storage_id": storage_id,
            "storage_display": storage_disp,
            "item_id": r.get("item_id"),
            "pack_id": r.get("pack_id"),
            "category_id": r.get("category_id"),
            "item_barcode": barcode,
            "vessel_item_name": r.get("vessel_item_name"),
            "vessel_item_quantity": num_to_int(r.get("vessel_item_quantity")) or 0,
            "totalitem_qty_sql": num_to_int(r.get("totalitem_qty_sql")) or 0,
            "certificate_qty_sql": num_to_int(r.get("certificate_qty_sql")) or 0,
            "vessel_item_law_code": r.get("vessel_item_law_code"),
            "pack_name": r.get("pack_name"),
        }

        for k, v in mapping.items():
            cidx = col(k)
            if cidx:
                ws.cell(row_idx, cidx).value = v

        cexp = col("vessel_item_expiration_date")
        if cexp:
            d = parse_date_any(r.get("vessel_item_expiration_date"))
            set_date_cell(ws.cell(row_idx, cexp), d, "dd-mm-yyyy")


