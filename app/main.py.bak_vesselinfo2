def fill_vessel_information_sheet(wb, vessel: Dict[str, Any], cert: Dict[str, Any], cert_pack_name: str, excel_row: Dict[str, Any]):
    # Use fixed cells matching your template layout (merged boxes)
    ws = wb[VESSEL_INFO_SHEET] if VESSEL_INFO_SHEET in wb.sheetnames else wb.create_sheet(VESSEL_INFO_SHEET)

    def yn(v):
        # Yes/No/blank (blank if missing)
        try:
            return yesno_or_blank(v)
        except Exception:
            # fallback if helper name differs
            if v is None or v == "":
                return ""
            sv = str(v).strip().lower()
            if sv in ("true","t","yes","y","1","on"):
                return "Yes"
            if sv in ("false","f","no","n","0","off"):
                return "No"
            return "Yes"

    def txt(v):
        return "" if v is None else str(v)

    # Basic vessel fields (from DB json keys you showed)
    company_name = vessel.get("company_name") or ""
    vessel_name  = vessel.get("vessel_name") or ""
    imo          = vessel.get("vessel_IMO") or vessel.get("vessel_imo") or vessel.get("imo") or ""
    flag         = vessel.get("vessel_flag_name") or vessel.get("vessel_flag") or ""
    crew         = vessel.get("vessel_crew_size") or ""
    category     = vessel.get("vessel_category_name") or vessel.get("vessel_category") or ""

    contact_name  = vessel.get("vessel_contact_name") or ""
    contact_email = vessel.get("vessel_contact_email") or vessel.get("email") or ""
    contact_phone = vessel.get("vessel_contact_phone") or ""
    purchasing    = vessel.get("purchasing_email") or ""
    notes         = vessel.get("vessel_notes") or ""

    malaria  = yn(vessel.get("malaria_area"))
    mfag     = yn(vessel.get("mfag"))
    female   = yn(vessel.get("female_onboard"))
    dang     = yn(vessel.get("dangerous_good"))
    narc     = yn(vessel.get("narcotics"))
    oxygen   = yn(vessel.get("medical_oxygen"))

    agreement = vessel.get("vessel_subscription_type") or ""

    rr = vessel.get("resupply_rate")
    rr_txt = f"{rr} Months" if rr not in (None, "") else ""

    em = vessel.get("expiration_months")
    em_txt = f"{em} Months" if em not in (None, "") else ""

    cert_end = parse_date_any((cert or {}).get("certificate_end_date"))
    cert_resupply = parse_date_any((cert or {}).get("certificate_resupply_rate"))

    # Top row of boxes
    ws["A4"].value = txt(company_name)
    ws["C4"].value = txt(vessel_name)
    ws["E4"].value = malaria
    ws["G4"].value = mfag

    # Certificate expiry date box (I4) (merged header is I3:J3 usually)
    if cert_end and cert_end < date.today():
        ws["I4"].value = "Expired"
    elif cert_end:
        ws["I4"].value = cert_end
        ws["I4"].number_format = "dd-mm-yyyy"
    else:
        ws["I4"].value = ""

    # Notes big box starts at L4
    ws["L4"].value = txt(notes)

    # Row 6
    ws["A6"].value = txt(contact_name)
    ws["C6"].value = txt(imo)
    ws["E6"].value = female
    if cert_resupply:
        ws["G6"].value = cert_resupply
        ws["G6"].number_format = "dd-mm-yyyy"
    else:
        ws["G6"].value = ""

    # Row 8
    ws["A8"].value = txt(contact_email)
    ws["C8"].value = txt(flag)
    ws["E8"].value = dang
    ws["G8"].value = txt(agreement)

    # Row 10
    ws["A10"].value = txt(contact_phone)
    ws["C10"].value = txt(crew)
    ws["E10"].value = narc
    ws["G10"].value = txt(rr_txt)

    # Row 12
    ws["A12"].value = txt(purchasing)
    ws["C12"].value = txt(category)
    ws["E12"].value = oxygen
    ws["G12"].value = txt(em_txt)

def build_workbook_bytes(excel_row: Dict[str, Any], vessel: Dict[str, Any], rows: List[Dict[str, Any]], cert: Dict[str, Any], cert_pack_name: str) -> bytes:
    wb = load_workbook(TEMPLATE_PATH)

    storages = get_vessel_storages(excel_row["vessel_id"], rows)
    inbound_disp, inbound_id = pick_inbound(storages)

    storage_id_by_name: Dict[str, str] = {}
    for disp, sid in storages:
        if disp:
            storage_id_by_name[disp.strip().lower()] = (sid or "").strip()

    fill_storages_sheet(wb, storages)
    fill_inventory_sheet(wb, rows, inbound_disp)
    fill_control_sheet(wb, rows, inbound_disp)
    fill_upload_sheet(wb, rows, inbound_disp, inbound_id, storage_id_by_name)
    fill_vessel_information_sheet(wb, vessel, cert or {}, cert_pack_name, excel_row)

    out = io.BytesIO()
    wb.save(out)
    return out.getvalue()


def send_email_with_attachment(to_email: str, subject: str, body: str, filename: str, content: bytes):
    if not SMTP_HOST:
        raise HTTPException(status_code=500, detail="SMTP_HOST not configured")

    msg = EmailMessage()
    msg["From"] = f"{FROM_NAME} <{FROM_EMAIL}>"
    msg["To"] = to_email
    msg["Subject"] = subject
    msg.set_content(body)

    msg.add_attachment(
        content,
        maintype="application",
        subtype="vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        filename=filename,
    )

    if SMTP_USE_TLS:
        with smtplib.SMTP(SMTP_HOST, SMTP_PORT) as s:
            s.starttls()
            if SMTP_USER:
                s.login(SMTP_USER, SMTP_PASSWORD)
            s.send_message(msg)
    else:
        with smtplib.SMTP(SMTP_HOST, SMTP_PORT) as s:
            if SMTP_USER:
                s.login(SMTP_USER, SMTP_PASSWORD)
            s.send_message(msg)


